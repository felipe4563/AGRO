# ============================================================================
# Variables de entorno para docker-compose (producción — VPS).
# Copiar a ".env" (NO subir ".env" al repositorio) y completar con valores
# reales antes de "docker compose up -d".
# ============================================================================

# Dominio público del sistema (sin https://, sin barra final)
DOMAIN=samagro.rusoft.dev

# Puerto interno (solo localhost del VPS) donde este cliente expone su
# frontend. Cada agropecuaria que corra en el MISMO VPS necesita un puerto
# distinto (el proxy reverso Nginx de cada dominio apunta a este puerto) —
# ver deploy/nuevo-cliente.sh, que asigna uno libre automáticamente.
HOST_PORT=8083

# Base de datos MySQL
DB_ROOT_PASSWORD=cambia_esta_clave_root
DB_NAME=bd_agropecuaria
DB_USER=agro_app
DB_PASSWORD=cambia_esta_clave_app

# Clave secreta para firmar los JWT (usar una cadena larga y aleatoria)
JWT_SECRET=cambia_esta_clave_jwt

# Banco Económico — API Market (pagos con QR)
BANCO_ECONOMICO_BASE_URL=https://apimkt.baneco.com.bo/ApiGateway
BANCO_ECONOMICO_USER=
BANCO_ECONOMICO_PASSWORD=
BANCO_ECONOMICO_AES_KEY=
BANCO_ECONOMICO_ACCOUNT_CREDIT=

# API de Personas (búsqueda por CI en Nuevo Cliente)
PERSONAS_API_BASE_URL=https://perapi.codewave.com.bo
PERSONAS_API_USER=
PERSONAS_API_PASSWORD=
